# Copie para .env.local (dev) ou configure na Vercel. Sem OCI_* / ORACLE_* o back-end usa mock e memória.

# OCID da tenancy OCI
OCI_TENANCY_OCID=
# OCID do usuário dono da API key
OCI_USER_OCID=
# Fingerprint da API key
OCI_FINGERPRINT=
# Chave privada PEM da API key (conteúdo, com \n escapados)
OCI_PRIVATE_KEY=
# Passphrase da chave privada, se houver
OCI_PRIVATE_KEY_PASSPHRASE=
# Região do Generative AI
OCI_REGION=sa-saopaulo-1
# OCID do compartment com acesso ao Generative AI
OCI_COMPARTMENT_OCID=
# Modelo de chat on-demand
OCI_GENAI_MODEL_ID=meta.llama-3.3-70b-instruct
# Endpoint de inferência (vazio = derivado da região)
OCI_GENAI_ENDPOINT=

# Usuário do Autonomous Database
ORACLE_DB_USER=
# Senha do usuário do banco
ORACLE_DB_PASSWORD=
# Connect string / alias do tnsnames (ex.: nurai_high)
ORACLE_DB_CONNECT_STRING=
# Wallet (ewallet.pem) em base64
ORACLE_DB_WALLET_PEM_BASE64=
# Senha da wallet
ORACLE_DB_WALLET_PASSWORD=
